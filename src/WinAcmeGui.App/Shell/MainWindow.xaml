<Window x:Class="WinAcmeGui.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinAcmeGui.App.Views"
        Title="win-acme GUI"
        Width="1320" Height="860" MinWidth="1040" MinHeight="680"
        Background="{DynamicResource WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

  <!-- F5 refreshes, Esc cancels the running operation, Ctrl+N opens the certificate wizard. -->
  <Window.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelOperationCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenCertificateWizardCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar: brand, navigation, live status. -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="18,26,18,20">
          <TextBlock Text="win-acme"
                     FontFamily="{DynamicResource UiFontFamily}"
                     FontSize="{DynamicResource FontSizeTitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SidebarTextBrush}" />
          <TextBlock Text="{Binding Culture[AppSubtitle]}"
                     Margin="1,4,0,0"
                     FontFamily="{DynamicResource UiFontFamily}"
                     FontSize="{DynamicResource FontSizeCaption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SidebarMutedBrush}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="14,0,14,16"
                Background="{DynamicResource SidebarSelectedBackground}"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="14,12,14,12">
          <StackPanel>
            <TextBlock Text="{Binding Culture[Status]}"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SidebarMutedBrush}" />
            <TextBlock Text="{Binding Status}"
                       Margin="0,6,0,0"
                       MaxHeight="88"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource SidebarTextBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Style="{StaticResource BusyBar}"
                         Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ListBox x:Name="NavigationList"
                   Style="{StaticResource NavigationList}"
                   ItemsSource="{Binding Sections}"
                   SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                   AutomationProperties.Name="{Binding Culture[AppSubtitle]}" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Content column: header, installation summary, active page. -->
    <Grid Grid.Column="1" Margin="{DynamicResource PagePadding}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding PageTitle}" Style="{StaticResource DisplayText}" />
          <TextBlock Text="{Binding PageDescription}"
                     Style="{StaticResource SecondaryText}"
                     Margin="0,4,24,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource MutedBackground}"
                  CornerRadius="{DynamicResource RadiusSmall}"
                  Padding="2" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Content="PT" Style="{StaticResource PillToggle}"
                            IsChecked="{Binding Culture.IsPortuguese, Mode=OneWay}"
                            Command="{Binding SetPortugueseCommand}"
                            AutomationProperties.Name="Português (Brasil)" />
              <ToggleButton Content="EN" Style="{StaticResource PillToggle}"
                            IsChecked="{Binding Culture.IsEnglish, Mode=OneWay}"
                            Command="{Binding SetEnglishCommand}"
                            AutomationProperties.Name="English" />
            </StackPanel>
          </Border>

          <Button Content="◐" Style="{StaticResource IconButton}"
                  Margin="0,0,10,0"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip="{Binding Culture[ToggleTheme]}"
                  AutomationProperties.Name="{Binding Culture[ToggleTheme]}" />

          <Button Content="{Binding Culture[CancelOperation]}"
                  Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Command="{Binding CancelOperationCommand}"
                  ToolTip="{Binding Culture[CancelOperationTooltip]}" />

          <Button Content="{Binding Culture[Download]}"
                  Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Command="{Binding DownloadCommand}"
                  ToolTip="{Binding Culture[DownloadTooltip]}" />

          <Button Content="{Binding Culture[Update]}"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding RefreshCommand}"
                  ToolTip="{Binding Culture[UpdateTooltip]}" />
        </StackPanel>
      </Grid>

      <views:ActiveInstallationBar Grid.Row="1" Margin="0,0,0,18" />

      <Grid Grid.Row="2">
        <views:HomePage Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
        <views:RenewalsPage Visibility="{Binding IsRenewals, Converter={StaticResource BoolToVisibility}}" />
        <views:NewCertificatePage Visibility="{Binding IsNewCertificate, Converter={StaticResource BoolToVisibility}}" />
        <views:InstallationPage Visibility="{Binding IsInstallation, Converter={StaticResource BoolToVisibility}}" />
        <views:SystemPage Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}}" />
        <views:ActivityPage Visibility="{Binding IsLogs, Converter={StaticResource BoolToVisibility}}" />
        <views:SettingsPage Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}" />
        <views:AboutPage Visibility="{Binding IsAbout, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
