<!-- Dark palette. Same key set as Palette.Light.xaml; the two are interchangeable at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <SolidColorBrush x:Key="WindowBackground" Color="#0F1621" />
  <SolidColorBrush x:Key="CardBackground" Color="#17202E" />
  <SolidColorBrush x:Key="CardBackgroundAlt" Color="#1C2735" />
  <SolidColorBrush x:Key="MutedBackground" Color="#1C2735" />
  <SolidColorBrush x:Key="HoverBackground" Color="#243141" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#0B121C" />
  <SolidColorBrush x:Key="SidebarHoverBackground" Color="#16202E" />
  <SolidColorBrush x:Key="SidebarSelectedBackground" Color="#1D2C3D" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EEF6" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BABC1" />
  <SolidColorBrush x:Key="MutedBrush" Color="#9BABC1" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="#DCE5F0" />
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="#7C8DA6" />

  <!-- Lines and focus -->
  <SolidColorBrush x:Key="BorderBrushSubtle" Color="#26313F" />
  <SolidColorBrush x:Key="BorderBrushStrong" Color="#33404F" />
  <SolidColorBrush x:Key="FocusBrush" Color="#4FB3C6" />

  <!-- Accent -->
  <SolidColorBrush x:Key="AccentBrush" Color="#2E92A8" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#38A8C0" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#24788B" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B333B" />

  <!-- Status -->
  <SolidColorBrush x:Key="StatusHealthyBrush" Color="#5CC98D" />
  <SolidColorBrush x:Key="StatusHealthySoftBrush" Color="#16301F" />
  <SolidColorBrush x:Key="StatusWarningBrush" Color="#E0AE5A" />
  <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="#33270F" />
  <SolidColorBrush x:Key="StatusDangerBrush" Color="#E97C7C" />
  <SolidColorBrush x:Key="StatusDangerSoftBrush" Color="#331A1A" />
  <SolidColorBrush x:Key="StatusNeutralBrush" Color="#8A9AB0" />
  <SolidColorBrush x:Key="StatusNeutralSoftBrush" Color="#212C39" />

  <!-- Controls -->
  <SolidColorBrush x:Key="ControlBackground" Color="#1B2634" />
  <SolidColorBrush x:Key="ControlDisabledBackground" Color="#1A2330" />
  <SolidColorBrush x:Key="ControlDisabledForeground" Color="#5F6E82" />
  <SolidColorBrush x:Key="GridHeaderBackground" Color="#1B2634" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#26313F" />
  <SolidColorBrush x:Key="GridSelectedBackground" Color="#1F3742" />
</ResourceDictionary>
