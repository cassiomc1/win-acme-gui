<Window x:Class="WinAcmeGui.App.Features.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <!-- Retype-to-confirm dialog used by Cancel and Revoke. -->
  <StackPanel Margin="24">
    <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" />
    <TextBlock x:Name="AnswerPrompt"
               Margin="0,16,0,0"
               Style="{StaticResource CaptionText}"
               TextWrapping="Wrap" />
    <TextBox x:Name="AnswerBox"
             AutomationProperties.Name="{Binding ElementName=AnswerPrompt, Path=Text}"
             AutomationProperties.HelpText="{Binding ElementName=MessageText, Path=Text}"
             TextChanged="AnswerChanged" />
    <TextBlock x:Name="MismatchText"
               Style="{StaticResource SecondaryText}"
               FontSize="{DynamicResource FontSizeSmall}"
               Foreground="{DynamicResource StatusDangerBrush}"
               Margin="0,8,0,0"
               AutomationProperties.LiveSetting="Polite"
               Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="CancelButton"
              Style="{StaticResource SecondaryButton}"
              Margin="0,0,8,0"
              MinWidth="96"
              IsCancel="True"
              Click="CancelClick" />
      <Button x:Name="ConfirmButton"
              Style="{StaticResource DangerButton}"
              MinWidth="96"
              IsDefault="True"
              IsEnabled="False"
              Click="ConfirmClick" />
    </StackPanel>
  </StackPanel>
</Window>
