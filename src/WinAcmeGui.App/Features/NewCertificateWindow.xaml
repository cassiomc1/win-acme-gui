<Window x:Class="WinAcmeGui.App.Features.NewCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo certificado" Width="620" Height="610" WindowStartupLocation="CenterOwner" Background="#F6F8FB">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="Emitir certificado" FontSize="24" FontWeight="SemiBold" Foreground="#172B4D" />
      <TextBlock Text="Preencha as opções; a linha de comando será revisada antes da execução." Foreground="#64748B" Margin="0,5,0,22" />
      <TextBlock Text="Domínios (separados por vírgula)" FontWeight="SemiBold" />
      <TextBox x:Name="Domains" Margin="0,7,0,16" Padding="9" AutomationProperties.Name="Domínios" />
      <TextBlock Text="Validação" FontWeight="SemiBold" />
      <ComboBox x:Name="Validation" SelectedIndex="0" Margin="0,7,0,16" Padding="8"><ComboBoxItem Content="http" /><ComboBoxItem Content="dns" /><ComboBoxItem Content="tls" /></ComboBox>
      <TextBlock Text="Chave privada" FontWeight="SemiBold" />
      <ComboBox x:Name="KeyType" SelectedIndex="0" Margin="0,7,0,16" Padding="8"><ComboBoxItem Content="rsa" /><ComboBoxItem Content="ec" /></ComboBox>
      <TextBlock Text="Armazenamento" FontWeight="SemiBold" />
      <ComboBox x:Name="Store" SelectedIndex="0" Margin="0,7,0,16" Padding="8"><ComboBoxItem Content="certificatestore" /><ComboBoxItem Content="pemfiles" /><ComboBoxItem Content="pfxfile" /></ComboBox>
      <CheckBox x:Name="Staging" Content="Usar servidor de testes (staging)" Margin="0,5,0,20" />
      <Border Background="#EEF6F8" BorderBrush="#BFDDE3" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,18">
        <TextBlock x:Name="Preview" Text="A prévia aparecerá aqui." TextWrapping="Wrap" Foreground="#245C68" />
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Pré-visualizar" Click="PreviewClick" />
        <Button Content="Executar" Click="ExecuteClick" Background="#2E7D91" Foreground="White" BorderThickness="0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
