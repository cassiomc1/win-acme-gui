<Application x:Class="WinAcmeGui.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:win="clr-namespace:WinAcmeGui.App.Windows"
             StartupUri="Shell/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          The palette is index 0 on purpose: MainWindow swaps this entry when the theme toggles,
          and every other dictionary references colours through DynamicResource.
        -->
        <ResourceDictionary Source="Theme/Palette.Light.xaml" />
        <ResourceDictionary Source="Theme/Typography.xaml" />
        <ResourceDictionary Source="Theme/Controls.Buttons.xaml" />
        <ResourceDictionary Source="Theme/Controls.Inputs.xaml" />
        <ResourceDictionary Source="Theme/Controls.Surfaces.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <win:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <win:InverseBooleanConverter x:Key="InverseBool" />
      <win:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
      <win:ResourceKeyToSoftBrushConverter x:Key="KeyToSoftBrush" />
      <win:StringPresenceToVisibilityConverter x:Key="StringToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
