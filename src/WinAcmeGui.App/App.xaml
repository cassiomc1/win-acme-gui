<Application x:Class="WinAcmeGui.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Shell/MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <SolidColorBrush x:Key="WindowBackground" Color="#F6F8FB" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#14283F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E7D91" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EEF2F6" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Resources>
</Application>
