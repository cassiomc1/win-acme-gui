<UserControl x:Class="WinAcmeGui.App.Views.InstallationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WinAcmeGui.App.Views">
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="{Binding Culture[DiscoveredInstallations]}" Style="{StaticResource SubtitleText}" />
          <TextBlock Text="{Binding Culture[DiscoveredInstallationsHint]}"
                     Style="{StaticResource SecondaryText}"
                     FontSize="{DynamicResource FontSizeSmall}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding Culture[SelectExecutableAction]}"
                  Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Command="{Binding SelectExecutableCommand}" />
          <Button Content="{Binding Culture[Download]}"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding DownloadCommand}" />
        </StackPanel>
      </Grid>

      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasInstallations, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Installations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- One row per discovered executable, with its own "use this" action. -->
                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10" Padding="16,14,16,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VersionText, StringFormat=win-acme {0}}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold" />
                        <Border Style="{StaticResource Badge}"
                                Margin="10,0,0,0"
                                Background="{Binding StateBrushKey, Converter={StaticResource KeyToSoftBrush}}"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="{Binding BadgeText}"
                                     Style="{StaticResource BadgeText}"
                                     Foreground="{Binding StateBrushKey, Converter={StaticResource KeyToBrush}}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding ExecutablePath}"
                                 Style="{StaticResource PathText}"
                                 Margin="0,6,0,0"
                                 ToolTip="{Binding ExecutablePath}" />
                      <TextBlock Text="{Binding ConfigurationPath}"
                                 Style="{StaticResource PathText}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="0,3,0,0"
                                 ToolTip="{Binding ConfigurationPath}" />
                      <TextBlock Text="{Binding Diagnostic}"
                                 Style="{StaticResource SecondaryText}"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 Foreground="{DynamicResource StatusWarningBrush}"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding DataContext.Culture[UseInstallation], RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsOperational}"
                            Command="{Binding DataContext.UseInstallationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <views:EmptyState Glyph="⌕"
                          Title="{Binding Culture[NoInstallationsTitle]}"
                          Hint="{Binding Culture[NoInstallationHint]}"
                          Visibility="{Binding HasInstallations, Converter={StaticResource InverseBoolToVisibility}}">
          <views:EmptyState.ActionContent>
            <Button Content="{Binding Culture[Update]}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" />
          </views:EmptyState.ActionContent>
        </views:EmptyState>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
