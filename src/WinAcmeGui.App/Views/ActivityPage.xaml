<UserControl x:Class="WinAcmeGui.App.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WinAcmeGui.App.Views"
             xmlns:win="clr-namespace:WinAcmeGui.App.Windows">
  <UserControl.Resources>
    <!-- DataGrid columns live outside the visual tree, so headers reach the page context through this proxy. -->
    <win:BindingProxy x:Key="PageContext" Data="{Binding}" />
  </UserControl.Resources>
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="{Binding Culture[ActivityLog]}" Style="{StaticResource SubtitleText}" />
          <TextBlock Text="{Binding Culture[ActivityLogHint]}"
                     Style="{StaticResource SecondaryText}"
                     FontSize="{DynamicResource FontSizeSmall}"
                     Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding Culture[CopyActivity]}"
                  Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Command="{Binding CopyActivityCommand}" />
          <Button Content="{Binding Culture[ClearActivity]}"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding ClearActivityCommand}" />
        </StackPanel>
      </Grid>

      <Grid>
        <DataGrid Style="{StaticResource FlatDataGrid}"
                  ItemsSource="{Binding Activity}"
                  RowHeight="40"
                  IsHitTestVisible="True"
                  AutomationProperties.Name="{Binding Culture[LogsDescription]}"
                  Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{Binding Data.Culture[TimeColumn], Source={StaticResource PageContext}}"
                                Binding="{Binding TimeText}" Width="90" />
            <DataGridTextColumn Header="{Binding Data.Culture[OperationColumn], Source={StaticResource PageContext}}"
                                Binding="{Binding OperationText}" Width="180" />
            <DataGridTemplateColumn Header="{Binding Data.Culture[ResultColumn], Source={StaticResource PageContext}}"
                                    Width="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Badge}"
                          Background="{Binding OutcomeBrushKey, Converter={StaticResource KeyToSoftBrush}}">
                    <TextBlock Text="{Binding OutcomeText}"
                               Style="{StaticResource BadgeText}"
                               Foreground="{Binding OutcomeBrushKey, Converter={StaticResource KeyToBrush}}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{Binding Data.Culture[DetailColumn], Source={StaticResource PageContext}}"
                                Binding="{Binding Detail}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>

        <views:EmptyState Glyph="≡"
                          Title="{Binding Culture[NoActivityTitle]}"
                          Hint="{Binding Culture[NoActivityHint]}"
                          Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVisibility}}" />
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
