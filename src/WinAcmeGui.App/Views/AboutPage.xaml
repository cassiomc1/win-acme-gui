<UserControl x:Class="WinAcmeGui.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}">
    <StackPanel VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Culture[AboutProject]}" Style="{StaticResource TitleText}" />
      <TextBlock Text="{Binding Culture[AboutBody]}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />

      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Culture[GuiVersion]}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
        <TextBlock Grid.Column="1" Text="{Binding GuiVersionText}" Style="{StaticResource BodyText}" />
      </Grid>

      <TextBlock Text="{Binding Culture[AboutUpstream]}"
                 Style="{StaticResource SecondaryText}"
                 FontSize="{DynamicResource FontSizeSmall}"
                 Margin="0,18,0,0" />

      <Button Content="{Binding Culture[OpenWinAcmeSite]}"
              Style="{StaticResource SecondaryButton}"
              HorizontalAlignment="Left"
              Margin="0,14,0,0"
              Command="{Binding OpenWinAcmeSiteCommand}" />
    </StackPanel>
  </Border>
</UserControl>
