<UserControl x:Class="WinAcmeGui.App.Views.ActiveInstallationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Always-visible context strip: which installation, which config, which ACME endpoint. -->
  <Border Style="{StaticResource Card}" Padding="18,14,18,14">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="1.6*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,18,0">
        <TextBlock Text="{Binding Culture[ActiveInstallation]}" Style="{StaticResource CaptionText}" />
        <TextBlock Text="{Binding ActiveExecutablePath}"
                   Style="{StaticResource PathText}"
                   Margin="0,5,0,0"
                   ToolTip="{Binding ActiveExecutablePath}" />
        <TextBlock Text="{Binding ActiveVersion, StringFormat=win-acme {0}}"
                   Style="{StaticResource SecondaryText}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Margin="0,3,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="0,0,18,0">
        <TextBlock Text="{Binding Culture[ConfigurationPathUpper]}" Style="{StaticResource CaptionText}" />
        <TextBlock Text="{Binding ActiveConfigurationPath}"
                   Style="{StaticResource PathText}"
                   Margin="0,5,0,0"
                   ToolTip="{Binding ActiveConfigurationPath}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Margin="0,0,18,0">
        <TextBlock Text="{Binding Culture[EndpointUpper]}" Style="{StaticResource CaptionText}" />
        <TextBlock Text="{Binding ActiveEndpoint}"
                   Style="{StaticResource PathText}"
                   Margin="0,5,0,0"
                   ToolTip="{Binding ActiveEndpoint}" />
        <!-- Staging vs production is the difference between a test and a rate-limited real order. -->
        <Border Style="{StaticResource Badge}"
                Margin="0,6,0,0"
                Background="{Binding EndpointBrushKey, Converter={StaticResource KeyToSoftBrush}}">
          <TextBlock Text="{Binding EndpointKindText}"
                     Style="{StaticResource BadgeText}"
                     Foreground="{Binding EndpointBrushKey, Converter={StaticResource KeyToBrush}}" />
        </Border>
      </StackPanel>

      <Button Grid.Column="3"
              Content="{Binding Culture[SelectExecutableAction]}"
              Style="{StaticResource SecondaryButton}"
              VerticalAlignment="Center"
              Command="{Binding SelectExecutableCommand}"
              ToolTip="{Binding Culture[SelectExecutableTooltip]}" />
    </Grid>
  </Border>
</UserControl>
