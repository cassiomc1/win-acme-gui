<UserControl x:Class="WinAcmeGui.App.Views.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Border Style="{StaticResource Card}" Padding="0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- Left accent rail carries the status colour without tinting the whole card. -->
      <Border Grid.Column="0"
              Background="{Binding AccentKey, ElementName=Root, Converter={StaticResource KeyToBrush}}"
              CornerRadius="10,0,0,10" />
      <StackPanel Grid.Column="1" Margin="18,16,18,16">
        <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource CaptionText}" />
        <TextBlock Text="{Binding Value, ElementName=Root}"
                   Style="{StaticResource MetricText}"
                   Margin="0,6,0,0"
                   Foreground="{Binding AccentKey, ElementName=Root, Converter={StaticResource KeyToBrush}}" />
        <TextBlock Text="{Binding Hint, ElementName=Root}"
                   Style="{StaticResource SecondaryText}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
